# Entorno y direccion. En producción, enlaza a localhost detrás de un proxy TLS.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# OPCIONAL: clave solo para integraciones servidor-a-servidor (p. ej. el bot).
# El panel NO la usa (entra con la sesión de LucidSales). Si la defines, que
# tenga al menos 32 caracteres aleatorios y nunca la pongas en una variable VITE_.
API_KEY=

# Cuenta de servicio contra LucidSales (NO uses una cuenta personal si puedes evitarlo)
LUCID_EMAIL=tu@email.com
LUCID_PASSWORD=tu_contraseña

# Tienda por defecto. Si lo dejas vacío se usa la primera tienda de la cuenta.
LUCID_TIENDA=3682

# URL base de la API de LucidSales (sin barra final)
# LUCID_BASE=https://panel.lucidsales.co/b

# En producción es obligatorio el origen HTTPS exacto del panel (sin *).
# CORS_ORIGIN=https://app.tudominio.com

# Registro de cambios (JSONL). Por defecto server/historial.jsonl
# HISTORIAL=./historial.jsonl

# Conversacion de cada pedido (chat de WhatsApp, JSONL). El bot la manda con
# POST /api/pedidos/:id/conversacion y el agente de Dropi la lee.
# CONVERSACION=./conversacion.jsonl

# Config + registro de la subida automatica a Dropi (JSON)
# SUBIDA_AUTO=./subidaAutomatica.json

# Timeout de cada llamada a LucidSales (milisegundos)
# TIMEOUT_MS=15000

# API publica de Inter Rapidisisimo (oficinas por municipio). Sin autenticacion.
# INTER_BASE=https://www3.interrapidisimo.com/Apicanalesventa/api

# Timeout de las consultas LENTAS a Inter (listado y horarios: 13-25 s medidos).
# Van en segundo plano, por eso es tan largo.
# TIMEOUT_INTER_LENTO_MS=45000

# --- LLM (lee el chat del pedido para validar antes de subir a Dropi) ---
# Habla con la API compatible con OpenAI (OpenAI, Groq, DeepSeek, Together...).
# La decision de subir/frenar la toma el CODIGO (agente.js), nunca el modelo:
# el LLM SOLO extrae producto, precio, direccion y confirmacion del chat.
# (opcional) también se puede poner desde el panel: Ajustes > Subida a Dropi > IA que lee los chats;
# lo guardado en el panel (config/llm.json) manda sobre estas variables
LLM_API_KEY=tu-llm-api-key
# LLM_BASE=https://api.openai.com/v1
# LLM_MODELO=gpt-5-mini
# LLM_TIMEOUT_MS=30000

# --- Dropi: subida de pedidos por NAVEGADOR (la API no acepta externos) ---
# Perfil persistente de Chrome donde vive la sesion de Dropi.
# Inicia sesion UNA vez con:  node dropiLogin.mjs
# DROPI_PERFIL=./.dropi-perfil
# DROPI_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# DROPI_HEADLESS=0
# DROPI_NAVEGADOR_MS=30000

# Google Sheets (publicado como CSV) con el mapa producto -> link de Dropi.
# Columnas: par, Nombre, idProductoDropi, nameProductoDropi, dropiLink, transportadora.
# DROPI_PRODUCTOS_CSV=https://docs.google.com/spreadsheets/d/<ID>/export?format=csv

# --- Rentabilidad de anuncios de Meta Ads (pagina /anuncios) ---
# El token de Meta, la TRM (USD -> COP) y las cuentas NO se ponen aqui: van en
# config/anuncios.json, que se relee en cada consulta (token nuevo sin reiniciar).
# ANUNCIOS_CONFIG=./config/anuncios.json
# ANUNCIOS_DIR=./anuncios

# --- Reparto automatico y horarios de usuarios ---
# ASIGNACION=./asignacion.json
# TZ_ASIGNACION=America/Bogota
# REPARTO_AUTOMATICO=0
# REPARTO_CADA=60

# --- Credenciales que el panel guarda para el backend (JSON, permisos 600) ---
# CREDENCIALES=./credenciales.json
